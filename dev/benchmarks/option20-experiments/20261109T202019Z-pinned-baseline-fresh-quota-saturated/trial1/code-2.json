  "text": "def is_balanced(text):\n    stack = []\n    pairs = {'(': ')', '[': ']', '{': '}'}\n    closing = {')', ']', '}'}\n    for char in text:\n        if char in pairs:\n            stack.append(pairs[char])\n        elif char in closing:\n            if not stack or stack.pop() != char:\n                return False\n    return len(stack) == 0",
