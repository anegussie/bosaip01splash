+              !SharedExpertArena::metadataBytes(48, 512) && !SharedExpertArena::metadataBytes(1, slots),
+          "shared arena metadata exceeds its bound");
+  using Range = std::pair<uint64_t, uint64_t>;
+  const auto ranges = [&](uint32_t layout, uint32_t slot) {
+    std::vector<Range> result;
+    uint64_t base = 0;
+    for (const auto &projection : layouts[layout])
+      for (const uint64_t bytes : projection) {
+        if (bytes) result.emplace_back(base + slot * bytes, base + (slot + 1) * bytes);
+        base += alignWeightOffset(slots * bytes);
+      }
+    return result;
+  };
+  for (uint32_t layout = 0; layout < layouts.size(); ++layout)
+    for (uint32_t slot = 0; slot < slots; ++slot) {
+      for (uint32_t other = 0; other < layouts.size(); ++other)
+        for (uint32_t victim = 0; victim < slots; ++victim) arena.resident(other, victim, true);
+      std::set<std::pair<uint32_t, uint32_t>> actual, expected;
+      arena.overwrite(layout, slot, [&](uint32_t other, uint32_t victim) { actual.emplace(other, victim); });
+      for (uint32_t other = 0; other < layouts.size(); ++other) {
+        if (other == layout) continue;
+        for (uint32_t victim = 0; victim < slots; ++victim) {
+          bool overlaps = false;
+          for (const auto &[begin, end] : ranges(layout, slot))
+            for (const auto &[from, to] : ranges(other, victim)) overlaps |= begin < to && from < end;
+          if (overlaps) expected.emplace(other, victim);
+        }
+      }
+      require(actual == expected, "a shared arena conflict differs from byte overlap");
+    }
+  arena.clear();
+  arena.overwrite(0, 0, [&](uint32_t, uint32_t) { throw std::runtime_error("cleared arena holds an expert"); });
