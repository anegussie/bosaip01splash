+// negatives let a slot table name overwritten weights.
+void sharedArenaConflicts() {
+  using splash::model::ExpertSlotPlanes;
+  using splash::model::SharedExpertArena;
+  using splash::model::alignWeightOffset;
+  constexpr uint32_t slots = 65;
+  const std::array<ExpertSlotPlanes, 3> layouts{{
