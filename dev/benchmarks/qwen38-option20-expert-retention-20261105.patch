diff --git a/runtime/model/SharedExpertArena.hpp b/runtime/model/SharedExpertArena.hpp
new file mode 100644
index 00000000..bd2b824a
--- /dev/null
+++ b/runtime/model/SharedExpertArena.hpp
@@ -0,0 +1,142 @@
+#pragma once
+
+// Byte-exact conflicts between the plane-contiguous slots of formats that
+// alias one expert arena. A slot remains cached until another format writes
+// bytes it owns. Masks make choosing a free slot independent of expert size;
+// their bounded reservation is part of ExpertStore's fixed memory budget.
+
+#include "model/ExpertChunkLayout.hpp"
+
+#include <bit>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace splash::model {
+
+class SharedExpertArena final {
+public:
+  static constexpr uint64_t kMaximumMetadataBytes = 4ULL << 20;
+
+  // Zero selects the original format-at-a-time policy for unusually many
+  // layouts. Check products against the bound before multiplying them.
+  [[nodiscard]] static uint64_t metadataBytes(uint64_t layouts, uint32_t slots) noexcept {
+    if (layouts < 2 || !slots) return 0;
+    const uint64_t words = (uint64_t{slots} + 63) / 64;
+    const uint64_t limit = kMaximumMetadataBytes / sizeof(uint64_t);
+    if (layouts > limit / words) return 0;
+    const uint64_t row = layouts * words;
+    if (limit / row < 2 || layouts > (limit / row - 2) / slots) return 0;
+    return (layouts * slots + 2) * row * sizeof(uint64_t);
+  }
+
+  SharedExpertArena() = default;
+  SharedExpertArena(std::span<const ExpertSlotPlanes> layouts, uint32_t slots)
+      : slots_(slots), words_((uint64_t{slots} + 63) / 64) {
+    if (!metadataBytes(layouts.size(), slots)) return;
+    live_.assign(layouts.size() * words_, 0);
+    reused_.assign(live_.size(), 0);
+    conflicts_.assign(layouts.size() * slots * live_.size(), 0);
+    for (size_t from = 0; from < layouts.size(); ++from) {
+      uint64_t fromBase = 0;
+      for (const auto &projection : layouts[from])
+        for (const uint64_t bytes : projection) {
+          if (bytes)
+            for (size_t to = 0; to < layouts.size(); ++to) {
+              if (from == to) continue;
+              uint64_t toBase = 0;
+              for (const auto &target : layouts[to])
+                for (const uint64_t targetBytes : target) {
+                  if (targetBytes)
+                    for (uint32_t slot = 0; slot < slots; ++slot) {
+                      const uint64_t begin = std::max(fromBase + slot * bytes, toBase);
+                      const uint64_t end = std::min(fromBase + (slot + 1) * bytes, toBase + slots * targetBytes);
+                      if (begin >= end) continue;
+                      for (uint64_t victim = (begin - toBase) / targetBytes;
+                           victim <= (end - 1 - toBase) / targetBytes; ++victim)
+                        conflicts_[(from * slots + slot) * live_.size() + to * words_ + victim / 64] |=
+                            uint64_t{1} << (victim % 64);
+                    }
+                  toBase += alignWeightOffset(slots * targetBytes);
+                }
+            }
+          fromBase += alignWeightOffset(slots * bytes);
+        }
+    }
+  }
+
+  [[nodiscard]] bool enabled() const noexcept { return !live_.empty(); }
+  void cool() noexcept { std::ranges::fill(reused_, uint64_t{0}); }
+  void clear() noexcept {
+    std::ranges::fill(live_, uint64_t{0});
+    cool();
+  }
+  void reuse(uint32_t layout, uint32_t slot) noexcept {
+    if (enabled()) reused_[layout * words_ + slot / 64] |= uint64_t{1} << (slot % 64);
+  }
+  void resident(uint32_t layout, uint32_t slot, bool held) noexcept {
+    if (!enabled()) return;
+    uint64_t &word = live_[layout * words_ + slot / 64];
+    const uint64_t bit = uint64_t{1} << (slot % 64);
+    if (held) word |= bit;
+    else {
+      word &= ~bit;
+      reused_[layout * words_ + slot / 64] &= ~bit;
+    }
+  }
+
+  // Prefer the free slot that evicts fewest experts of other formats. ARC
+  // still chooses which expert of this format to recycle when none is free.
+  // Reused experts cost four cold ones, a soft preference that can adapt
+  // when routes change, rather than pinning an old working set forever.
+  [[nodiscard]] std::optional<uint32_t> prefer(uint32_t layout, std::span<const uint32_t> free) const noexcept {
+    std::optional<uint32_t> best;
+    uint64_t fewest = UINT64_MAX;
+    for (auto at = free.rbegin(); at != free.rend(); ++at) {
+      const uint64_t *mask = conflicts_.data() + (uint64_t{layout} * slots_ + *at) * live_.size();
+      uint64_t victims = 0;
+      for (size_t word = 0; word < live_.size(); ++word)
+        victims += std::popcount(mask[word] & live_[word]) + 3 * std::popcount(mask[word] & reused_[word]);
+      if (victims < fewest) {
+        best = *at;
+        fewest = victims;
+        if (!victims) break;
+      }
+    }
+    return best;
+  }
+
+  // A large prefill scans almost a whole layer. Discard other formats once
+  // rather than finding the same conflicts for each of its hundreds of
+  // misses. Decode resumes byte-exact retention on its next load.
+  template <typename Evict> void discardOthers(uint32_t layout, Evict evict) {
+    for (size_t word = 0; word < live_.size(); ++word) {
+      if (word / words_ == layout) continue;
+      uint64_t victims = live_[word];
+      while (victims) {
+        evict(static_cast<uint32_t>(word / words_),
+              static_cast<uint32_t>((word % words_) * 64 + std::countr_zero(victims)));
+        victims &= victims - 1;
+      }
+    }
+  }
+
+  template <typename Evict> void overwrite(uint32_t layout, uint32_t slot, Evict evict) {
+    const uint64_t *mask = conflicts_.data() + (uint64_t{layout} * slots_ + slot) * live_.size();
+    for (size_t word = 0; word < live_.size(); ++word) {
+      uint64_t victims = mask[word] & live_[word];
+      while (victims) {
+        const uint32_t victim = static_cast<uint32_t>((word % words_) * 64 + std::countr_zero(victims));
+        evict(static_cast<uint32_t>(word / words_), victim);
+        victims &= victims - 1;
+      }
+    }
+  }
+
+private:
+  uint32_t slots_ = 0;
+  uint64_t words_ = 0;
+  std::vector<uint64_t> live_, reused_, conflicts_;
+};
+
+} // namespace splash::model
