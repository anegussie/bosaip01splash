SPLASH_FLASH_NEXT_PLE_MEMORY="${SPLASH_FLASH_NEXT_PLE_MEMORY:-64M}"
SPLASH_FLASH_NEXT_PREFILL_CHUNK_TOKENS_DEFAULTED=0
