SPLASH_QWEN_ROOT="${SPLASH_QWEN_ROOT:-/Users/mymac/splash/qwen3.5-9B}"
SPLASH_QWEN_PYTHON="${SPLASH_QWEN_PYTHON:-$SPLASH_QWEN_ROOT/.venv/bin/python}"
